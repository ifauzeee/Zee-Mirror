# .gitignore untuk Zee-Mirror Bot

# Binary
/zee-mirror
/zee-mirror.exe
/zee-mirror-bot

# Task
.task/

# Environment files
.env
*.env.local

# Config files dengan credentials
config/rclone.conf
config/cookies.txt
config/*.json
!config/*.example

# Download temporary files
downloads/
*.torrent

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Go
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
# go.sum - should be tracked

# Logs
*.log
logs/

# Docker
.docker/

# Temp
view_file
tmp/
temp/
*.tmp

# Database
config/*.db
config/*.db-journal
config/*.db-shm
config/*.db-wal