# .gitignore untuk Zee-Mirror Bot

# Binary
/zee-mirror
/zee-mirror.exe
/zee-mirror-bot

# Environment files
.env
*.env.local

# Web Dashboard
/dist/
dashboard/node_modules/
dashboard/dist/
.eslintcache
.stylelintcache

# Config files dengan credentials
config/rclone.conf
config/cookies.txt
config/*.json
!config/*.example

# Download temporary files
downloads/
*.torrent

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.task/

# OS files
.DS_Store
Thumbs.db

# Go
vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Logs
# Logs
*.log
logs/

# Database
config/*.db
config/*.db-journal
config/*.db-shm
config/*.db-wal
*.db
*.db-journal
*.db-shm
*.db-wal

# Temp
view_file
tmp/
temp/
*.tmp
zee-mirror-tmp
