# REQUIRED CONFIGURATION
BOT_TOKEN=your_bot_token_here
OWNER_ID=123456789

# OPTIONAL CONFIGURATION
# Comma-separated list of authorized Telegram User IDs
AUTHORIZED_USERS=

# Rclone destination (format: remote:path)
RCLONE_DEST=gdrive:/MirrorBot

# Download concurrency limit
MAX_CONCURRENT_DOWNLOADS=3

# System timezone
TZ=Asia/Jakarta