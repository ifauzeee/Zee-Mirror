# ==========================================
# 🛑 PENGATURAN WAJIB (REQUIRED)
# ==========================================

# Token Bot Telegram dari @BotFather
BOT_TOKEN=your_bot_token_here

# User ID Telegram pemilik bot (angka)
OWNER_ID=your_telegram_user_id


# ==========================================
# API & JARINGAN (NETWORKING)
# ==========================================

# Port API internal bot (health, metrics, webhook)
API_PORT=8080


# ==========================================
# 📂 PENYIMPANAN & DOWNLOAD (STORAGE)
# ==========================================

# Tujuan rclone default (format: remote:path)
RCLONE_DEST=gdrive:/Zee-Mirror

# Optional: Index URL for Google Drive (e.g. https://your-index.workers.dev)
# Link yang diberikan ke user akan menggunakan format: {INDEX_URL}/{path_file}
INDEX_URL=

# Direktori internal container (Jangan diubah kecuali perlu)
DOWNLOAD_DIR=/app/downloads
CONFIG_DIR=/app/config


# ==========================================
# ⚙️ KONFIGURASI BOT (BOT SETTINGS)
# ==========================================

# Daftar User ID yang diizinkan selain Owner (pisahkan dengan koma)
AUTHORIZED_USERS=

# Batasan download bersamaan
MAX_CONCURRENT_DOWNLOADS=3

# Mencegah download file yang sama secara bersamaan
STOP_DUPLICATE=false

# Batas harian task per user (-1 = tanpa batas)
DEFAULT_MAX_DAILY_TASKS=-1

# Batas harian bandwidth per user (Contoh: 10GB, -1 = tanpa batas)
DEFAULT_MAX_DAILY_BANDWIDTH=-1

# Otomatis mengorganisir file berdasarkan kategori (Movies, Music, dll)
SMART_AUTO_ORGANIZATION=false


# ==========================================
# 📝 LOGGING & DEBUG
# ==========================================

# Level: debug, info, warn, error
LOG_LEVEL=info

# Zona waktu sistem (Contoh: Asia/Jakarta)
TZ=Asia/Jakarta


# ==========================================
# 🌐 WEBHOOK MODE (OPTIONAL)
# ==========================================

# Aktifkan mode webhook untuk performa lebih baik
# Webhook mengirim update secara instan (vs polling setiap beberapa detik)
# PENTING: Server harus memiliki HTTPS dan dapat diakses publik oleh Telegram
USE_WEBHOOK=false

# URL publik server Anda (HARUS HTTPS di production)
# Telegram akan mengirim update ke: {WEBHOOK_URL}/api/telegram/webhook
# Contoh: https://your-domain.com atau https://your-ip:443
WEBHOOK_URL=

# Token rahasia untuk verifikasi request webhook (opsional, sangat direkomendasikan)
# Telegram akan mengirimkan token ini di header X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=


# ==========================================
# 🤖 TELEGRAM BOT API (FOR 2GB+ FILES)
# ==========================================

# Diperlukan untuk local-bot-api agar bisa menangani file > 2GB
# Dapatkan API ID & Hash dari https://my.telegram.org 
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Endpoint Local Bot API (Default untuk Docker Compose)
# TELEGRAM_API=http://telegram-bot-api:8081/bot%s/%s


# ==========================================
# 🤖 USERBOT CONFIGURATION (OPTIONAL)
# ==========================================

# Diperlukan untuk mengakses Private Channel/Group
# Generate string ini menggunakan: go run cmd/session-gen/main.go
# APP_ID dan APP_HASH akan otomatis menggunakan nilai dari TELEGRAM_API_ID & HASH di atas (via Docker)
USER_SESSION_STRING=


# ==========================================
# ⚔️ VIKING FILE CONFIGURATION
# ==========================================

# Optional: Hash user Viking File untuk upload ke akun tertentu
# Kosongkan untuk anonymous upload
VIKING_USER_HASH=
