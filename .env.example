# Zee-Mirror Bot Environment Variables
# Copy file ini ke .env dan isi nilainya

# =============================================
# REQUIRED - Harus diisi!
# =============================================

# Token bot dari @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram User ID Anda (owner). Dapatkan dari @userinfobot
OWNER_ID=123456789

# =============================================
# OPTIONAL - Bisa dikosongkan
# =============================================

# Daftar user yang diizinkan menggunakan bot (comma-separated)
# Contoh: 111111111,222222222,333333333
AUTHORIZED_USERS=

# Rclone remote destination
# Format: remote_name:path
# Contoh: gdrive:/MirrorBot atau mega:/Backups
RCLONE_DEST=gdrive:/MirrorBot

# Maksimal download bersamaan
MAX_CONCURRENT_DOWNLOADS=3

# Timezone
TZ=Asia/Jakarta
