# ==========================================
# 🛑 PENGATURAN WAJIB (REQUIRED)
# ==========================================
BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id

# ==========================================
# 🌐 DASHBOARD & JARINGAN (NETWORKING)
# ==========================================
# Port luar yang diakses di browser (Port 80 disarankan untuk Azure/Cloud)
DASHBOARD_PORT=80

# Port dalam container (Direkomendasikan tetap 8080)
DASHBOARD_PORT_INTERNAL=8080

# URL publik lengkap untuk link di Telegram (Contoh: http://74.225.216.230)
WEB_DASHBOARD_URL=http://your-ip-or-domain

# Password untuk login ke dashboard (X-API-Key)
WEB_DASHBOARD_TOKEN=zee-mirror-secret

# ==========================================
# 📂 PENYIMPANAN & DOWNLOAD (STORAGE)
# ==========================================
# Tujuan rclone (format: remote:path)
RCLONE_DEST=gdrive:/Zee-Mirror

# Batasan download bersamaan
MAX_CONCURRENT_DOWNLOADS=3

# Direktori internal (Jangan diubah kecuali Anda tahu apa yang Anda lakukan)
DOWNLOAD_DIR=/app/downloads
CONFIG_DIR=/app/config
SMART_AUTO_ORGANIZATION=false

# ==========================================
# 📝 LOGGING & DEBUG
# ==========================================
# Level: debug, info, warn, error
LOG_LEVEL=info

# Zona waktu sistem
TZ=Asia/Jakarta

# ==========================================
# 🤖 TELEGRAM API (FOR 2GB+ FILES)
# ==========================================
# Dapatkan dari https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API=http://telegram-bot-api:8081/bot%s/%s